# Copie pra .env e preencha. Nada aqui é commitado.

# Banco SQLite (arquivo). No Docker o compose sobrescreve pra /app/data.
DATABASE_URL=file:./data/eonarga.db
UPLOAD_DIR=./data/uploads

# URL pública do app (usada em links absolutos e no manifest).
APP_URL=http://localhost:3000

# Primeiro admin. Só é usado se ainda não existir nenhum admin no banco.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=troque-esta-senha

# Mapa: centro inicial (Praça XV, Centro de Floripa) e User-Agent exigido pelo Nominatim.
MAP_CENTER=-27.5975,-48.5500
GEOCODE_USER_AGENT=eonarga/0.1 (contato@exemplo.com)

# Opcional: habilita Places Autocomplete do Google no cadastro de lugar.
GOOGLE_MAPS_API_KEY=

# reCAPTCHA falso do login: always | off
NEXT_PUBLIC_CAPTCHA_MODE=always

# Caddy (só Docker): domínio que recebe o certificado. Local: localhost
SITE_ADDRESS=eonarga.com.br
